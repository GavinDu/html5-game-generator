  "game": {
    "audience": "family",
    "description": "Ride the cloud, catch falling sky shards, and mend the holes torn in the sky.",
    "entryScene": "sky",
    "id": "sample-ribbon-sky",
    "orientation": "portrait",
    "sessionTargetSeconds": 25,
    "title": "Ribbon Mends the Sky"
  },
