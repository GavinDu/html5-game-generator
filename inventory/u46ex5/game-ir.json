    ]
  },
  "rules": [
    {
      "id": "start-music",
      "when": {
        "event": "game_start"
      },
      "actions": [
        {
          "type": "play_sound",
          "assetId": "theme"
        }
      ]
    },
    {
      "id": "shard-caught",
      "when": {
        "event": "collected",
        "source": "player",
        "target": "shard"
      },
      "actions": [
        {
          "type": "add_score",
          "value": 1
        },
        {
          "type": "emit_particles",
          "target": "shard",
          "value": 12
        },
        {
          "type": "destroy_entity",
          "target": "shard"
        },
        {
          "type": "play_sound",
          "assetId": "glass"
        }
      ]
    },
    {
      "id": "shard-cyan-caught",
      "when": {
        "event": "collected",
        "source": "player",
        "target": "shard_cyan"
      },
      "actions": [
        {
          "type": "add_score",
          "value": 2
        },
        {
          "type": "emit_particles",
          "target": "shard_cyan",
          "value": 14
        },
        {
          "type": "destroy_entity",
          "target": "shard_cyan"
        },
        {
          "type": "play_sound",
          "assetId": "glass"
        }
      ]
    },
    {
      "id": "shard-gold-caught",
      "when": {
        "event": "collected",
        "source": "player",
        "target": "shard_gold"
      },
      "actions": [
        {
          "type": "add_score",
          "value": 3
        },
        {
          "type": "emit_particles",
          "target": "shard_gold",
          "value": 18
        },
        {
          "type": "destroy_entity",
          "target": "shard_gold"
        },
        {
          "type": "play_sound",
          "assetId": "glass"
        }
      ]
    },
    {
      "id": "demon-hit",
      "when": {
        "event": "collision",
        "source": "player",
        "target": "demon"
      },
      "actions": [
        {
          "type": "change_health",
          "value": -1
        },
        {
          "type": "set_velocity",
          "target": "demon",
          "value": [
            -260,
            -140
          ]
        },
        {
          "type": "camera_shake",
          "value": 6
        },
        {
          "type": "show_text",
          "value": "哎呀！被小恶魔撞到了。"
        },
        {
          "type": "play_sound",
          "assetId": "thud"
        }
      ]
    },
    {
      "id": "mend-hole-1",
      "when": {
        "event": "score_reached",
        "value": 4
      },
      "actions": [
        {
          "type": "set_asset",
          "target": "hole",
          "assetId": "hole_closed"
        },
        {
          "type": "emit_particles",
          "target": "hole",
          "value": 22
        },
        {
          "type": "show_text",
          "value": "天空补好了一处裂口！"
        },
        {
          "type": "play_sound",
          "assetId": "stitch"
        }
      ]
    },
    {
      "id": "mend-hole-2",
      "when": {
        "event": "score_reached",
        "value": 7
      },
      "actions": [
        {
          "type": "set_asset",
          "target": "hole2",
          "assetId": "hole_closed"
        },
        {
          "type": "emit_particles",
          "target": "hole2",
          "value": 22
        },
        {
          "type": "show_text",
          "value": "天空快要完整了……"
        },
        {
          "type": "play_sound",
          "assetId": "stitch"
        }
      ]
    },
    {
      "id": "sky-mended",
      "when": {
        "event": "score_reached",
        "source": "player",
        "value": 10
      },
      "actions": [
        {
          "type": "show_text",
          "value": "天空补好了！"
        },
        {
          "type": "play_sound",
          "assetId": "theme"
        },
        {
          "type": "end_game",
          "value": true
        },
        {
          "type": "play_sound",
          "assetId": "stitch"
        }
      ]
    },
    {
      "id": "mend-glow",
      "when": {
        "event": "score_reached",
        "value": 2
      },
      "actions": [
        {
          "type": "emit_particles",
          "target": "hole",
          "value": 14
        },
        {
          "type": "emit_particles",
          "target": "hole2",
          "value": 14
        },
        {
          "type": "show_text",
          "value": "天空开始缝合了……"
        }
      ]
    }
  ],
