      "action": "move_left",
      "input": "keyboard",
      "key": "ArrowLeft"
    },
    {
      "action": "move_right",
      "input": "keyboard",
      "key": "ArrowRight"
    },
    {
      "action": "move_up",
      "input": "keyboard",
      "key": "ArrowUp"
    },
    {
      "action": "move_down",
      "input": "keyboard",
