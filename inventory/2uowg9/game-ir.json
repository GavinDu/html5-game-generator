  "game": {
    "audience": "family",
    "description": "Drag to dodge between the lanes, grab the stars, and outrun the nurse and her syringe.",
    "entryScene": "chase",
    "id": "escape-from-injection",
    "orientation": "portrait",
    "sessionTargetSeconds": 40,
    "title": "Escape from the Injection"
  },
  "inputBindings": [
    {
      "action": "move",
      "input": "tap"
    },
    {
      "action": "move",
      "input": "swipe"
    },
    {
      "action": "move_left",
      "input": "keyboard",
      "key": "ArrowLeft"
    },
    {
      "action": "move_right",
      "input": "keyboard",
      "key": "ArrowRight"
    },
    {
      "action": "move_up",
      "input": "keyboard",
      "key": "ArrowUp"
    },
    {
      "action": "move_down",
      "input": "keyboard",
      "key": "ArrowDown"
    }
  ],
  "irVersion": "1.2",
  "metadata": {
    "tags": [
      "family",
      "dodging",
      "drawing-inspired"
    ]
  },
  "rules": [
    {
      "id": "start-music",
      "when": {
        "event": "game_start"
      },
      "actions": [
        {
          "type": "play_sound",
          "assetId": "theme"
        }
      ]
    },
    {
      "id": "star-collected",
      "when": {
        "event": "collected",
        "source": "player",
        "target": "star"
      },
      "actions": [
        {
          "type": "add_score",
          "value": 1
        },
        {
          "type": "emit_particles",
          "target": "star",
          "value": 10
        },
        {
          "type": "destroy_entity",
          "target": "star"
        },
        {
          "type": "play_sound",
          "assetId": "ding"
        }
      ]
    },
    {
      "id": "star-gold-collected",
      "when": {
        "event": "collected",
        "source": "player",
        "target": "star_gold"
      },
      "actions": [
        {
          "type": "add_score",
          "value": 2
        },
        {
          "type": "emit_particles",
          "target": "star_gold",
          "value": 14
        },
        {
          "type": "destroy_entity",
          "target": "star_gold"
        },
        {
          "type": "play_sound",
          "assetId": "ding"
        }
      ]
    },
    {
      "id": "syringe-hit",
      "when": {
        "event": "collision",
        "source": "player",
        "target": "syringe"
      },
      "actions": [
        {
          "type": "change_health",
          "value": -1
        },
        {
          "type": "apply_impulse",
          "target": "syringe",
          "value": [
            -260,
            -220
          ]
        },
        {
          "type": "camera_shake",
          "value": 8
        },
        {
          "type": "show_text",
          "value": "Ouch! The syringe nicked you."
        },
        {
          "type": "play_sound",
          "assetId": "boing"
        }
      ]
    },
    {
      "id": "chaser-caught",
      "when": {
        "event": "collision",
        "source": "player",
        "target": "chaser"
      },
      "actions": [
        {
          "type": "change_health",
          "value": -1
        },
        {
          "type": "teleport_entity",
          "target": "chaser",
          "value": [
            195,
            772
          ]
        },
        {
          "type": "camera_shake",
          "value": 6
        },
        {
          "type": "show_text",
          "value": "The chaser grabbed you — shake free!"
        },
        {
          "type": "play_sound",
          "assetId": "thud"
        }
      ]
    },
    {
      "id": "germ-hit",
      "when": {
        "event": "collision",
        "source": "player",
        "target": "germ"
      },
      "actions": [
        {
          "type": "change_health",
          "value": -1
        },
        {
          "type": "apply_impulse",
          "target": "germ",
          "value": [
            -320,
            -260
          ]
        },
        {
          "type": "camera_shake",
          "value": 5
        },
        {
          "type": "show_text",
          "value": "A germ bounced you!"
        },
        {
          "type": "play_sound",
          "assetId": "boing"
        }
      ]
    },
    {
      "id": "germ-respawn",
      "when": {
        "event": "timer_elapsed",
        "value": 9
      },
      "actions": [
        {
          "type": "teleport_entity",
          "target": "germ",
          "value": [
            60,
            790
          ]
        },
        {
          "type": "set_velocity",
          "target": "germ",
          "value": [
            130,
            0
          ]
        }
      ]
    },
    {
      "id": "escape-complete",
      "when": {
        "event": "score_reached",
        "source": "player",
        "value": 15
      },
      "actions": [
        {
          "type": "show_text",
          "value": "You escaped!"
        },
        {
          "type": "play_sound",
          "assetId": "theme"
        },
        {
          "type": "end_game",
          "value": true
        },
        {
          "type": "play_sound",
          "assetId": "sting"
        }
      ]
    },
    {
      "id": "progress-5",
      "when": {
        "event": "score_reached",
        "value": 5
      },
      "actions": [
        {
          "type": "show_text",
          "value": "5 stars — keep going!"
        },
        {
          "type": "set_alpha",
          "target": "hall-mid",
          "value": 1
        }
      ]
    },
    {
      "id": "progress-10",
      "when": {
        "event": "score_reached",
        "value": 10
      },
      "actions": [
        {
          "type": "show_text",
          "value": "10 stars — almost out!"
        },
        {
          "type": "set_alpha",
          "target": "hall-far",
          "value": 1
        },
        {
          "type": "set_alpha",
          "target": "hall-mid",
          "value": 0
        }
      ]
    }
  ],
