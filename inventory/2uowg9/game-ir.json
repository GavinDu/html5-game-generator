  "game": {
    "audience": "family",
    "description": "Tap left or right to change exactly one lane. Collect courage stars to widen the chaser gap, but the chase ends when you are caught.",
    "entryScene": "chase",
    "id": "escape-from-injection",
    "orientation": "portrait",
    "sessionTargetSeconds": 1200,
    "title": "Escape from the Injection"
  },
  "inputBindings": [
    {
      "action": "move",
      "input": "tap"
    },
    {
      "action": "move_left",
      "input": "keyboard",
      "key": "ArrowLeft"
    },
    {
      "action": "move_right",
      "input": "keyboard",
      "key": "ArrowRight"
    }
  ],
  "irVersion": "1.2",
  "metadata": {
    "tags": [
      "family",
      "dodging",
      "drawing-inspired"
    ]
  },
  "rules": [
    {
      "id": "start-music",
      "when": {
        "event": "game_start"
      },
      "actions": [
        {
          "type": "play_sound",
          "assetId": "theme"
        }
      ]
    },
    {
      "id": "star-collected",
      "when": {
        "event": "collected",
        "source": "player",
        "target": "star"
      },
      "actions": [
        {
          "type": "add_score",
          "value": 25
        },
        {
          "type": "add_variable",
          "variable": "chaser_gap",
          "value": 12
        },
        {
          "type": "emit_particles",
          "target": "star",
          "value": 10
        },
        {
          "type": "destroy_entity",
          "target": "star"
        },
        {
          "type": "play_sound",
          "assetId": "ding"
        }
      ]
    },
    {
      "id": "star-gold-collected",
      "when": {
        "event": "collected",
        "source": "player",
        "target": "star_gold"
      },
      "actions": [
        {
          "type": "add_score",
          "value": 25
        },
        {
          "type": "add_variable",
          "variable": "chaser_gap",
          "value": 12
        },
        {
          "type": "emit_particles",
          "target": "star_gold",
          "value": 14
        },
        {
          "type": "destroy_entity",
          "target": "star_gold"
        },
        {
          "type": "play_sound",
          "assetId": "ding"
        }
      ]
    },
    {
      "id": "syringe-hit",
      "when": {
        "event": "collision",
        "source": "player",
        "target": "syringe"
      },
      "actions": [
        {
          "type": "add_variable",
          "variable": "chaser_gap",
          "value": -45
        },
        {
          "type": "camera_shake",
          "value": 8
        },
        {
          "type": "show_text",
          "value": "Ouch! The syringe nicked you."
        },
        {
          "type": "play_sound",
          "assetId": "boing"
        }
      ]
    },
    {
      "id": "syringe02-hit",
      "when": {
        "event": "collision",
        "source": "player",
        "target": "syringe02"
      },
      "actions": [
        {
          "type": "add_variable",
          "variable": "chaser_gap",
          "value": -45
        },
        {
          "type": "camera_shake",
          "value": 8
        },
        {
          "type": "show_text",
          "value": "Ouch! The syringe nicked you."
        },
        {
          "type": "play_sound",
          "assetId": "boing"
        }
      ]
    },
    {
      "id": "germ-hit",
      "when": {
        "event": "collision",
        "source": "player",
        "target": "germ"
      },
      "actions": [
        {
          "type": "add_variable",
          "variable": "chaser_gap",
          "value": -45
        },
        {
          "type": "camera_shake",
          "value": 5
        },
        {
          "type": "show_text",
          "value": "A germ bounced you!"
        },
        {
          "type": "play_sound",
          "assetId": "boing"
        }
      ]
    },
    {
      "id": "germ-respawn",
      "when": {
        "event": "timer_elapsed",
        "value": 9
      },
      "actions": [
        {
          "type": "teleport_entity",
          "target": "germ",
          "value": [
            60,
            790
          ]
        },
        {
          "type": "set_velocity",
          "target": "germ",
          "value": [
            130,
            0
          ]
        }
      ]
    },
    {
      "id": "running-score",
      "when": {
        "event": "timer_elapsed",
        "value": 1
      },
      "actions": [
        {
          "type": "add_score",
          "value": 10
        }
      ]
    },
    {
      "id": "progress-40",
      "when": {
        "event": "timer_elapsed",
        "value": 40
      },
      "conditions": [
        {
          "variable": "elapsed",
          "operator": "lt",
          "value": 80
        }
      ],
      "actions": [
        {
          "type": "show_text",
          "value": "The hallway! The chase gets faster."
        },
        {
          "type": "set_alpha",
          "target": "hall-mid",
          "value": 1
        }
      ]
    },
    {
      "id": "progress-80",
      "when": {
        "event": "timer_elapsed",
        "value": 40
      },
      "conditions": [
        {
          "variable": "elapsed",
          "operator": "gte",
          "value": 80
        }
      ],
      "actions": [
        {
          "type": "show_text",
          "value": "A new route — the chaser stays close!"
        },
        {
          "type": "set_alpha",
          "target": "hall-far",
          "value": 1
        },
        {
          "type": "set_alpha",
          "target": "hall-mid",
          "value": 0
        }
      ]
    },
    {
      "id": "gap-caught",
      "when": {
        "event": "variable_changed"
      },
      "conditions": [
        {
          "variable": "chaser_gap",
          "operator": "lte",
          "value": 55
        }
      ],
      "actions": [
        {
          "type": "show_text",
          "value": "Caught! A little shot and tears — the chase is over."
        },
        {
          "type": "play_sound",
          "assetId": "thud"
        },
        {
          "type": "end_game",
          "value": false
        }
      ]
    },
    {
      "id": "inevitable-catch",
      "when": {
        "event": "timer_elapsed",
        "value": 1200
      },
      "actions": [
        {
          "type": "set_variable",
          "variable": "chaser_gap",
          "value": 55
        }
      ]
    }
  ],
