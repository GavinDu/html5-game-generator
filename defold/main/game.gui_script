local runtime = require "main.game_ir_runtime"
local DESIGN_W, DESIGN_H = 390, 844

local function to_gui_position(x, y)
    return vmath.vector3(x * gui.get_width() / DESIGN_W, gui.get_height() - y * gui.get_height() / DESIGN_H, 0)
end

local function add_label(text, x, y, size, color)
    local node = gui.new_text_node(to_gui_position(x, y), text or "")
    gui.set_font(node, "default")
    gui.set_color(node, color or vmath.vector4(1, 1, 1, 1))
    gui.set_scale(node, vmath.vector3(size or 1, size or 1, 1))
    return node
end

local function entity_color(kind)
    if kind == "player" then return vmath.vector4(0.12, 0.8, 0.95, 1) end
    if kind == "pickup" then return vmath.vector4(1, 0.25, 0.5, 1) end
    if kind == "enemy" or kind == "obstacle" then return vmath.vector4(0.9, 0.22, 0.2, 1) end
    return vmath.vector4(1, 0.62, 0.16, 1)
end

local function make_entity_node(entity)
    local p, s = entity.position or {195, 422}, entity.size or {48, 48}
    local node = gui.new_box_node(to_gui_position(p[1], p[2]), vmath.vector3(s[1] * gui.get_width() / DESIGN_W, s[2] * gui.get_height() / DESIGN_H, 0))
    gui.set_color(node, entity_color(entity.kind))
    return node
end

local function render(self)
    gui.set_size(self.background, vmath.vector3(gui.get_width(), gui.get_height(), 0))
    gui.set_position(self.background, vmath.vector3(gui.get_width() / 2, gui.get_height() / 2, -1))
    for _, entity in ipairs(self.state.scene.entities) do
        local view = self.views[entity.id]
        if view then
            local visible = not self.state.destroyed[entity.id]
            gui.set_enabled(view.box, visible)
            gui.set_enabled(view.label, visible)
            if visible then
                local p = self.state.positions[entity.id] or entity.position
                gui.set_position(view.box, to_gui_position(p[1], p[2]))
                gui.set_position(view.label, to_gui_position(p[1], p[2] - ((entity.size or {48,48})[2] * 0.65)))
            end
        end
    end
    gui.set_text(self.score_label, "Score: " .. tostring(self.state.score))
    gui.set_text(self.status_label, self.state.message or (self.state.ended and (self.state.won and "You did it! Press R to restart" or "Game over — press R to restart") or "Drag to move"))
end

function init(self)
    msg.post(".", "acquire_input_focus")
    local raw = sys.load_resource("/main/game_ir.json")
    assert(raw, "Missing /main/game_ir.json")
    self.ir = json.decode(raw)
    assert(self.ir.irVersion == "1.0", "Unsupported Game IR version: " .. tostring(self.ir.irVersion))
    self.state = runtime.new(self.ir)
    self.background = gui.new_box_node(vmath.vector3(195, 422, -1), vmath.vector3(390, 844, 0))
    gui.set_color(self.background, vmath.vector4(0.06, 0.09, 0.18, 1))
    self.views = {}
    for _, entity in ipairs(self.state.scene.entities) do
        local box = make_entity_node(entity)
        local p = entity.position or {195, 422}
        local label = add_label(entity.id, p[1], p[2], 0.55, vmath.vector4(0.05, 0.05, 0.08, 1))
        self.views[entity.id] = {box = box, label = label}
    end
    self.title_label = add_label(self.ir.game.title or "Game", 195, 28, 1.0, vmath.vector4(1, 1, 1, 1))
    self.score_label = add_label("Score: 0", 60, 62, 0.8, vmath.vector4(1, 0.88, 0.35, 1))
    self.status_label = add_label("Drag to move", 195, 810, 0.65, vmath.vector4(0.8, 0.86, 1, 1))
    self.state.emit("game_start")
    render(self)
end

function update(self, dt)
    render(self)
end

function on_input(self, action_id, action)
    if action_id == hash("restart") and action.pressed then
        self.state = runtime.new(self.ir)
        self.state.emit("game_start")
        return true
    end
    if action_id == hash("touch") and action.x ~= nil then
        if not self.state.ended then
            local x = action.x * DESIGN_W / gui.get_width()
            local y = (gui.get_height() - action.y) * DESIGN_H / gui.get_height()
            self.state.move_player(x, y)
            render(self)
        end
        return true
    end
    return false
end
