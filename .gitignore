*.zip

# Env / secrets
.env
.env.*

# Editor
.idea/
.vscode/
*.swp
/godot/*/.godot/

# Godot project images (decoded from committed .b64 text by godot/tools/decode_assets.py)
/godot/*/assets/*.png
/godot/*/assets/*.jpg
