; Engine configuration file.

config_version=5

[application]

config/name="Ribbon Mends the Sky"
config/description="Stitch the sky-holes shut and bonk wind demons. Godot rework of the GameShim original."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.227, 0.29, 0.478, 1)
icon="res://icon.svg"

[display]

window/size/viewport_width=390
window/size/viewport_height=844
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
