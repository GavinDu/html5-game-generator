modules = ["nodejs-24", "python-base-3.13", "go-1.25"]
[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 go run ./cmd/server"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "vm"
# Build-time module resolution; the deployed VM starts a compiled binary and
# never needs to fetch a Go dependency on a request or cold startup.
build = ["sh", "-c", "mkdir -p bin && CGO_ENABLED=0 go build -mod=readonly -trimpath -o bin/server ./cmd/server"]
run = ["./bin/server"]
